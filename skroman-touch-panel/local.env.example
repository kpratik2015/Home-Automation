# Copy to local.env (gitignored) and fill in your values.
#   cp local.env.example local.env

# Panel SoftAP (join Mac to this before provisioning)
SKIT_SOFTAP_SSID=SKITxxxxxxxx
SKIT_SOFTAP_PASSWORD=your-softap-password

# Home 2.4 GHz WiFi (target network for the panel)
HOME_WIFI_SSID=YourHomeWiFi
HOME_WIFI_PASSWORD=your-home-wifi-password

# Optional: panel IP on LAN after join (discover with kitouch_control.py --scan)
PANEL_LAN_IP=
